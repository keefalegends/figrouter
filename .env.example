# FigRouter — Environment Variables
# Salin file ini menjadi .env dan isi nilainya

# ─── Figma OAuth App ──────────────────────────────────────────────────────────
# Buat di: https://www.figma.com/developers/apps
FIGMA_CLIENT_ID=your_figma_client_id_here
FIGMA_CLIENT_SECRET=your_figma_client_secret_here

# URI redirect harus sama persis dengan yang didaftarkan di Figma Developer App
FIGMA_REDIRECT_URI=http://localhost:3334/oauth/callback

# ─── FigRouter Server ─────────────────────────────────────────────────────────
# Port untuk MCP server (yang dipakai AI agent / 9router)
FIGROUTER_PORT=3333

# Port untuk OAuth callback server (sementara, hanya saat login)
FIGROUTER_AUTH_PORT=3334

# ─── Opsional ─────────────────────────────────────────────────────────────────
# Level log: debug | info | warn | error (default: info)
# LOG_LEVEL=info
